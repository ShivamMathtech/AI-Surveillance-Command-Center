# Optional overrides. Docker creates random persistent secrets automatically.
DEMO_MODE=true
ADMIN_USERNAME=admin
SESSION_MINUTES=30
ALLOWED_RTSP_HOSTS=
# Local development only; omit for SQLite default:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/scc
# REDIS_URL=redis://localhost:6379/0
# JWT_SECRET=set-through-your-secret-manager
# API_URL / WS_URL are same-origin by design; use the Vite or Nginx proxy.
