  "components": {
    "schemas": {
      "AnnotationInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "false_positive",
              "missed_detection",
              "correct_association",
              "incorrect_association"
            ],
            "title": "Kind"
          },
          "track_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
