          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "bbox": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox"
          },
          "timestamp": {
            "type": "number",
            "title": "Timestamp"
          },
          "sensor_id": {
            "type": "string",
            "title": "Sensor Id"
          },
          "position": {
            "anyOf": [
