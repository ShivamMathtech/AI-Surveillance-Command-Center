            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "x": {
            "type": "number",
            "maximum": 500.0,
            "minimum": -500.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 500.0,
            "minimum": -500.0,
            "title": "Y"
          },
          "radius": {
